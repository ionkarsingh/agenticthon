# ---------- Firebase (client) — paste your Firebase web app config here ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------- SMTP (server) — used by nodemailer ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Agenticthon <your@gmail.com>"

# ---------- Site ----------
# Base URL of the deployed portal. Leave EMPTY to auto-detect from the browser
# (correct on localhost and on Vercel previews). Set it on Vercel to pin the
# production domain, e.g. https://agenticthon.vercel.app
VITE_SITE_URL=

# Dev ports (local only)
VITE_PORT=5173
API_PORT=5174
